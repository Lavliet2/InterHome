<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:media="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui.MediaElement"
             xmlns:pageModels="clr-namespace:InterHome.PageModels"
             x:Class="InterHome.Pages.MusicPlayerPage"
             x:DataType="pageModels:MusicPlayerPageModel"
             Title="Музыкальный плеер"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">

    <Grid Padding="20" RowSpacing="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Label Grid.Row="0"
               Text="Музыкальный плеер"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,30"
               TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />

        <!-- Информация о треке -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="15">
            <Label Text="{Binding CurrentTrackName}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />

            <Label Text="{Binding CurrentArtist}"
                   FontSize="18"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
        </VerticalStackLayout>

        <!-- Прогресс бар -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="10"
                             Margin="0,20,0,20">
            <ProgressBar Progress="{Binding Position.TotalSeconds}"
                         Maximum="{Binding Duration.TotalSeconds}"
                         BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3C}"
                         Color="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                         HeightRequest="8" />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       Text="{Binding Position, StringFormat='{0:mm\\:ss}'}"
                       FontSize="14"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                <Label Grid.Column="1"
                       Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                       FontSize="14"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Кнопки управления -->
        <HorizontalStackLayout Grid.Row="3"
                               HorizontalOptions="Center"
                               Spacing="20">
            <Button Text="{Binding PlayPauseButtonText}"
                    Command="{Binding PlayPauseCommand}"
                    BackgroundColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    WidthRequest="150"
                    HeightRequest="50" />

            <Button Text="⏹ Стоп"
                    Command="{Binding StopCommand}"
                    BackgroundColor="{AppThemeBinding Light=#FF3B30, Dark=#FF453A}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    WidthRequest="100"
                    HeightRequest="50" />
        </HorizontalStackLayout>

        <!-- MediaElement (скрытый) -->
        <media:MediaElement x:Name="MediaPlayer"
                            Grid.Row="4"
                            IsVisible="False"
                            ShouldAutoPlay="False"
                            ShouldShowPlaybackControls="False" />
    </Grid>
</ContentPage>
